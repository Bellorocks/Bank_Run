# Statistiche d'uso anonime (PostHog, piano gratuito, server UE).
# Copia questo file in ".env.production" e incolla la "Project API Key" del tuo
# progetto PostHog (Project settings > Project API key, inizia con "phc_").
# E' una chiave pubblica per sola scrittura: puo' stare nel codice del sito.
# Senza chiave il gioco funziona uguale e non chiede alcun consenso.
VITE_POSTHOG_KEY=
# Lascia cosi' se il progetto e' su eu.posthog.com; per quello USA usa https://us.i.posthog.com
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Informativa privacy (si apre dal gioco e all'indirizzo /?privacy).
# Chi e' il titolare del trattamento e come contattarlo: per esempio
# VITE_PRIVACY_OWNER=Mario Rossi
# VITE_PRIVACY_CONTACT=privacy@tuodominio.it
VITE_PRIVACY_OWNER=
VITE_PRIVACY_CONTACT=
